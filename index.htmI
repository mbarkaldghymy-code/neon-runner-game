<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Neon Runner</title>

<style>
* {
  box-sizing: border-box;
  user-select: none;
}

body {
  margin: 0;
  background: #080812;
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
  overflow: hidden;
}

h1 {
  margin: 12px 0 5px;
  font-size: 26px;
  color: #00f7ff;
  text-shadow: 0 0 12px #00f7ff;
}

#score {
  font-size: 20px;
  margin-bottom: 8px;
}

#game {
  width: 360px;
  height: 600px;
  max-width: 95vw;
  position: relative;
  margin: auto;
  overflow: hidden;
  background:
    linear-gradient(90deg,
      transparent 0%,
      transparent 48%,
      #22224d 49%,
      #22224d 51%,
      transparent 52%);
  border: 3px solid #00f7ff;
  box-shadow: 0 0 25px #00f7ff;
  border-radius: 12px;
}

.line {
  position: absolute;
  width: 5px;
  height: 80px;
  background: #00f7ff;
  box-shadow: 0 0 12px #00f7ff;
  left: 177px;
}

#player {
  position: absolute;
  width: 48px;
  height: 70px;
  background: linear-gradient(#ff2b6d, #8b0035);
  border: 2px solid white;
  border-radius: 12px;
  bottom: 30px;
  left: 156px;
  box-shadow: 0 0 18px #ff2b6d;
}

#player::before {
  content: "";
  position: absolute;
  width: 24px;
  height: 30px;
  background: #222;
  left: 10px;
  top: 8px;
  border-radius: 6px;
}

.enemy {
  position: absolute;
  width: 48px;
  height: 70px;
  background: linear-gradient(#7d5cff, #260080);
  border: 2px solid white;
  border-radius: 12px;
  box-shadow: 0 0 18px #7d5cff;
}

.coin {
  position: absolute;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #ffe600;
  border: 3px solid white;
  box-shadow: 0 0 18px #ffe600;
}

#message {
  margin: 8px;
  font-size: 17px;
}

button {
  background: #00f7ff;
  color: #05050a;
  border: none;
  border-radius: 10px;
  padding: 10px 25px;
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 0 15px #00f7ff;
}

.controls {
  margin-top: 8px;
}

.control {
  width: 70px;
  height: 45px;
  margin: 3px;
  padding: 5px;
  font-size: 25px;
}
</style>
</head>

<body>

<h1>⚡ NEON RUNNER ⚡</h1>

<div id="score">النقاط: 0 | العملات: 0 ❤️❤️❤️</div>

<div id="game">

  <div id="player"></div>

  <div class="enemy" id="enemy"></div>

  <div class="coin" id="coin"></div>

  <div class="line" style="top:0"></div>
  <div class="line" style="top:160px"></div>
  <div class="line" style="top:320px"></div>
  <div class="line" style="top:480px"></div>

</div>

<div id="message">⬅️ ➡️ حرّك اللاعب واجمع العملات</div>

<div class="controls">
  <button class="control" onclick="moveLeft()">⬅️</button>
  <button class="control" onclick="moveRight()">➡️</button>
</div>

<button onclick="restartGame()">🔄 إعادة اللعب</button>

<script>

const player = document.getElementById("player");
const enemy = document.getElementById("enemy");
const coin = document.getElementById("coin");
const scoreText = document.getElementById("score");
const message = document.getElementById("message");

let playerX = 156;
let enemyX = 100;
let enemyY = -100;

let coinX = 250;
let coinY = -250;

let score = 0;
let coins = 0;
let lives = 3;
let speed = 5;
let gameOver = false;

function randomX() {
  return Math.floor(Math.random() * 300);
}

function moveLeft() {
  if (!gameOver) {
    playerX -= 30;
    if (playerX < 0) playerX = 0;
    player.style.left = playerX + "px";
  }
}

function moveRight() {
  if (!gameOver) {
    playerX += 30;
    if (playerX > 312) playerX = 312;
    player.style.left = playerX + "px";
  }
}

document.addEventListener("keydown", function(event) {

  if (event.key === "ArrowLeft") {
    moveLeft();
  }

  if (event.key === "ArrowRight") {
    moveRight();
  }

});

function hit(aX, aY, aW, aH, bX, bY, bW, bH) {

  return (
    aX < bX + bW &&
    aX + aW > bX &&
    aY < bY + bH &&
    aY + aH > bY
  );

}

function updateScore() {

  scoreText.textContent =
    "النقاط: " + score +
    " | العملات: " + coins +
    " ❤️".repeat(lives);

}

function gameLoop() {

  if (gameOver) return;

  enemyY += speed;
  coinY += speed;

  enemy.style.top = enemyY + "px";
  coin.style.top = coinY + "px";

  // تجاوز العدو
  if (enemyY > 620) {

    enemyY = -100;
    enemyX = randomX();

    enemy.style.left = enemyX + "px";

    score++;

    if (score % 5 === 0) {
      speed += 0.7;
    }

    updateScore();
  }

  // ظهور عملة جديدة
  if (coinY > 620) {

    coinY = -200 - Math.random() * 200;
    coinX = randomX();

    coin.style.left = coinX + "px";
  }

  // اصطدام بالعدو
  if (
    hit(
      playerX, 540, 48, 70,
      enemyX, enemyY, 48, 70
    )
  ) {

    lives--;

    enemyY = -100;
    enemyX = randomX();

    enemy.style.left = enemyX + "px";

    updateScore();

    if (lives <= 0) {

      gameOver = true;

      message.textContent =
        "💥 انتهت اللعبة! نتيجتك: " + score;

      return;
    }
  }

  // جمع العملة
  if (
    hit(
      playerX, 540, 48, 70,
      coinX, coinY, 28, 28
    )
  ) {

    coins++;

    score += 5;

    coinY = -200 - Math.random() * 200;
    coinX = randomX();

    coin.style.left = coinX + "px";

    updateScore();
  }

  requestAnimationFrame(gameLoop);
}

function restartGame() {

  playerX = 156;
  enemyY = -100;
  coinY = -250;

  enemyX = randomX();
  coinX = randomX();

  score = 0;
  coins = 0;
  lives = 3;
  speed = 5;

  gameOver = false;

  player.style.left = playerX + "px";
  enemy.style.left = enemyX + "px";
  coin.style.left = coinX + "px";

  message.textContent =
    "⬅️ ➡️ حرّك اللاعب واجمع العملات";

  updateScore();

  gameLoop();
}

enemy.style.left = enemyX + "px";
coin.style.left = coinX + "px";

updateScore();

gameLoop();

</script>

</body>
</html>
